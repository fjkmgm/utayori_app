<header class="bg-white shadow-sm mb-6 border-b border-gray-100">
  <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
    <%= link_to 'UTAYORI', root_path, class: 'text-xl font-bold text-gray-800 hover:opacity-80' %>

    <nav class="space-x-4 flex items-center">
      <% if logged_in? %>
        <span class="text-sm text-gray-600"><%= current_user.name %> さん</span>
        <%= link_to 'マイページ', user_path(current_user), class: 'text-sm text-blue-600 hover:underline' %>
        <%= button_to 'ログアウト', logout_path, method: :delete, class: 'text-sm text-red-600 hover:underline cursor-pointer bg-transparent border-0' %>
      <% else %>
        <%= link_to 'ログイン', login_path, class: 'text-sm text-blue-600 hover:underline' %>
        <%= link_to 'ユーザー登録', new_user_path, class: 'text-sm text-blue-600 hover:underline' %>
      <% end %>
    </nav>
  </div>
</header>