<div class="max-w-md mx-auto mt-8 p-6 bg-white rounded-lg shadow-md">
  <h1 class="text-2xl font-bold mb-6 text-center">ログイン</h1>

  <%= form_with url: login_path, local: true do |f| %>
    <div class="mb-4">
      <%= f.label :email, 'メールアドレス', class: 'block text-gray-700 text-sm font-bold mb-2' %>
      <%= f.email_field :email, class: 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500' %>
    </div>

    <div class="mb-6">
      <%= f.label :password, 'パスワード', class: 'block text-gray-700 text-sm font-bold mb-2' %>
      <%= f.password_field :password, class: 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500' %>
    </div>

    <div>
      <%= f.submit 'ログイン', class: 'w-full bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded-md cursor-pointer transition' %>
    </div>
  <% end %>
</div>