<div class="max-w-2xl mx-auto bg-white p-6 rounded-lg shadow-sm">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">日記を書く</h1>

  <%= form_with model: @diary, local: true, class: "space-y-4" do |f| %>
    <% if @diary.errors.any? %>
      <div class="bg-red-50 text-red-700 p-4 rounded-md mb-4 border border-red-200">
        <ul class="list-disc list-inside text-sm">
          <% @diary.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= f.label :written_on, '日付', class: 'block text-sm font-medium text-gray-700 mb-1' %>
      <%= f.date_field :written_on, class: 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500' %>
    </div>

    <div>
      <%= f.label :title, 'タイトル', class: 'block text-sm font-medium text-gray-700 mb-1' %>
      <%= f.text_field :title, class: 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500', placeholder: '今日のできごとや気持ち' %>
    </div>

    <div>
      <%= f.label :body, '本文', class: 'block text-sm font-medium text-gray-700 mb-1' %>
      <%= f.text_area :body, rows: 6, class: 'w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500', placeholder: '自由に入力してください' %>
    </div>

    <div class="flex justify-end space-x-3 pt-4">
      <%= link_to 'キャンセル', diaries_path, class: 'px-4 py-2 border border-gray-300 rounded-md text-gray-700 hover:bg-gray-50 text-sm' %>
      <%= f.submit '投稿する', class: 'px-4 py-2 bg-emerald-600 text-white rounded-md hover:bg-emerald-700 cursor-pointer text-sm font-medium' %>
    </div>
  <% end %>
</div>