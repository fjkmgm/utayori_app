<div class="max-w-4xl mx-auto">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">日記一覧</h1>
    <%= link_to '日記を書く', new_diary_path, class: 'bg-emerald-600 text-white px-4 py-2 rounded-md hover:bg-emerald-700 text-sm font-medium' %>
  </div>

  <% if @diaries.any? %>
    <div class="space-y-4">
      <% @diaries.each do |diary| %>
        <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-100 hover:border-emerald-200 transition">
          <div class="flex justify-between items-start mb-2">
            <h2 class="text-lg font-semibold text-gray-800">
              <%= link_to diary.title, diary_path(diary), class: 'hover:text-emerald-700 transition' %>
            </h2>
            <span class="text-xs text-gray-500"><%= l diary.written_on, format: :long %></span>
          </div>

          <p class="text-gray-600 whitespace-pre-wrap text-sm mb-4"><%= truncate(diary.body, length: 120) %></p>

          <% if diary.poem %>
            <div class="bg-amber-50/70 p-4 rounded-md border border-amber-200/80 text-amber-900">
              <div class="flex items-center space-x-2 mb-1">
                <span class="text-xs bg-amber-200/80 text-amber-900 px-2 py-0.5 rounded font-medium">今日の一首</span>
                <span class="text-xs text-amber-700">第<%= diary.poem.number %>首 / <%= diary.poem.poet %></span>
              </div>
              <p class="font-serif text-sm font-medium">
                <%= diary.poem.kami_no_ku %> <%= diary.poem.shimo_no_ku %>
              </p>
            </div>
          <% end %>

          <div class="mt-3 text-right">
            <%= link_to '詳細を見る →', diary_path(diary), class: 'text-xs text-emerald-600 hover:text-emerald-800 font-medium' %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white p-8 text-center text-gray-500 rounded-lg shadow-sm border border-gray-100">
      <p class="mb-4">まだ日記が投稿されていません。</p>
      <%= link_to '最初の日記を書く', new_diary_path, class: 'text-emerald-600 hover:underline font-medium text-sm' %>
    </div>
  <% end %>
</div>