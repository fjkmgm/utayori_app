<div class="max-w-5xl mx-auto px-4 pb-12">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-2">百人一首一覧</h1>
    <p class="text-sm text-gray-600">歌番号・歌人名・キーワードから和歌を探すことができます。</p>
  </div>

  <!-- 検索フォーム -->
  <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-100 mb-6">
    <%= form_with url: poems_path, method: :get, local: true, class: "flex flex-col sm:flex-row gap-3" do |f| %>
      <div class="flex-1">
        <%= f.text_field :q,
            value: @query,
            placeholder: "歌番号・歌人名・キーワードで検索（例：1、紫式部、恋）",
            class: "w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500 text-sm" %>
      </div>
      <div class="flex gap-2">
        <%= f.submit "検索", class: "px-5 py-2 bg-emerald-600 text-white rounded-md hover:bg-emerald-700 cursor-pointer text-sm font-medium transition" %>
        <% if @query.present? %>
          <%= link_to "クリア", poems_path, class: "px-4 py-2 border border-gray-300 rounded-md text-gray-600 hover:bg-gray-50 text-sm flex items-center" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- 件数表示 -->
  <div class="mb-4 text-sm text-gray-600">
    <% if @query.present? %>
      「<span class="font-semibold text-gray-800"><%= @query %></span>」の検索結果：<%= @poems.size %>首
    <% else %>
      全 <%= @poems.size %>首
    <% end %>
  </div>

  <!-- 和歌一覧 -->
  <% if @poems.any? %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% @poems.each do |poem| %>
        <article class="bg-white p-6 rounded-lg shadow-sm border border-gray-100 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between border-b border-gray-100 pb-3 mb-4">
              <span class="text-xs font-semibold bg-amber-100 text-amber-900 px-2.5 py-1 rounded">
                第<%= poem.number %>首
              </span>
              <span class="text-sm font-medium text-gray-700"><%= poem.poet %></span>
            </div>

            <div class="bg-amber-50/50 p-4 rounded-md border border-amber-100 mb-4">
              <p class="font-serif text-base font-medium tracking-wider text-gray-900 mb-1">
                <%= poem.kami_no_ku %>
              </p>
              <p class="font-serif text-base font-medium tracking-wider text-gray-900">
                <%= poem.shimo_no_ku %>
              </p>
            </div>

            <% if poem.keywords.any? %>
              <div class="flex flex-wrap gap-1.5 mb-4">
                <% poem.keywords.each do |keyword| %>
                  <%= link_to "##{keyword.name}",
                      poems_path(q: keyword.name),
                      class: "text-xs bg-gray-100 hover:bg-emerald-50 text-gray-600 hover:text-emerald-700 px-2 py-0.5 rounded transition" %>
                <% end %>
              </div>
            <% end %>
          </div>

          <details class="text-sm border-t border-gray-100 pt-3 group">
            <summary class="cursor-pointer text-xs font-medium text-emerald-700 hover:text-emerald-800 select-none">
              現代語訳・解説を見る
            </summary>
            <div class="mt-3 space-y-2.5 text-gray-700 leading-relaxed">
              <div>
                <h2 class="text-xs font-bold text-gray-500 mb-0.5">現代語訳</h2>
                <p><%= poem.translation %></p>
              </div>
              <div>
                <h2 class="text-xs font-bold text-gray-500 mb-0.5">解説</h2>
                <p><%= poem.explanation %></p>
              </div>
            </div>
          </details>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white p-10 rounded-lg shadow-sm border border-gray-100 text-center">
      <p class="text-gray-600 mb-3">条件に一致する和歌が見つかりませんでした。</p>
      <%= link_to "すべての和歌を表示する", poems_path, class: "text-sm text-emerald-600 hover:underline font-medium" %>
    </div>
  <% end %>
</div>